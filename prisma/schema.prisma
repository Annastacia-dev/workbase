generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationSize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
}

enum MembershipRole {
  OWNER
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum OrganizationStructure {
  SINGLE_COUNTRY
  MULTI_COUNTRY
}

enum CompanyType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LIMITED_LIABILITY_PARTNERSHIP
  BRANCH
  HOLDING
  SUBSIDIARY
  NGO
  COOPERATIVE
  GOVERNMENT
  OTHER
}

/// App profile mirrored from Supabase Auth. `id` matches `auth.users.id`.
model User {
  id          String   @id @db.Uuid
  email       String   @unique
  fullName    String
  isSuperuser Boolean  @default(false)
  createdAt   DateTime @default(now())

  memberships Membership[]
}

model Organization {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  industry         String?
  size             OrganizationSize?
  companyType      CompanyType?
  structure        OrganizationStructure  @default(SINGLE_COUNTRY)
  country          String                 @default("KE")
  countries        String[]               @default([])
  timezone         String                 @default("Africa/Nairobi")
  subscriptionPlan SubscriptionPlan       @default(TRIAL)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  memberships Membership[]
  domains     OrganizationDomain[]
}

/// Email / web domains used to identify a company workspace.
model OrganizationDomain {
  id             String   @id @default(cuid())
  organizationId String
  domain         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
}

/// Join table so a user can belong to multiple orgs later without a rewrite.
/// v1 assumes one membership per user.
model Membership {
  id             String         @id @default(cuid())
  userId         String         @db.Uuid
  organizationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}
